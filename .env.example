# ─────────────────────────────────────────────────────────────
# EstilistaIA · Variables de entorno
# Desarrollo: copiá este archivo a .env.local (no se sube a Git).
# Producción: cargalas en Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ═══ SERVIDOR (funciones de /api). Secretas: NUNCA con prefijo VITE_ ═══

# Stripe → Developers → API keys. Pruebas: sk_test_…  Producción: sk_live_…
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe → Product catalog → tu producto → precio recurrente (mismo modo que la clave).
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe → Developers → Webhooks → tu endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase → Project Settings → API (o Data API).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave service_role (o "secret key" sb_secret_…). Saltea la seguridad por fila: solo servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL pública de la app, sin barra final (éxito/cancelación de Stripe y portal).
APP_URL=https://estilistaia.vercel.app

# ═══ FRONTEND (Vite solo expone al navegador lo que empieza con VITE_) ═══

# Mismo proyecto de Supabase. La clave anon (o "publishable key" sb_publishable_…) es pública por diseño.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# "true" muestra "Continuar con Google" (requiere activar Google en Supabase → Authentication → Providers).
VITE_AUTH_GOOGLE=false

# Dominio de los enlaces y QR de invitación.
VITE_PUBLIC_APP_URL=https://estilistaia.vercel.app

# Texto del precio en pantalla.
VITE_PRICE_LABEL=US$ 4,99 por mes

# MODO DEMO PARA TESTERS. "true" = todas las funciones Premium abiertas, más un selector
# "Ver como: Premium / Gratuita / En prueba" en la franja superior.
# Usalo solo en un despliegue aparte para testers (ej. un Preview de Vercel).
# En el sitio público SIEMPRE false: con true, cualquiera tendría Premium sin pagar.
VITE_SHOW_PREMIUM_SIMULATOR=false

# No hace falta con Stripe Checkout por redirección. Solo para Embedded Checkout o Elements.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# ═══ ESCANEO CORPORAL (opcional) ═══
# Por defecto MediaPipe se descarga de jsDelivr y el modelo de Google. Si preferís servirlos
# desde tu dominio (ver docs/escaneo-corporal.md), poné acá las rutas, por ejemplo:
# VITE_MEDIAPIPE_WASM_URL=/mediapipe/wasm
# VITE_POSE_MODEL_URL=/mediapipe/pose_landmarker_full.task
